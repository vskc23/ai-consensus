# Secrets only. Non-secret settings (model choice, search, token
# caps) live in the committed config.json, so nothing about the
# model lineup has to live next to keys.
# Copy this file to ~/.config/ai_consensus/.env, outside the
# workspace, so coding agents never see these values.

OPENROUTER_API_KEY=sk-or-...
TAVILY_API_KEY=tvly-...

# Cap output length (tokens). ~1k for answers, ~4k for the judge JSON.
ANSWER_MAX_TOKENS=1024
JUDGE_MAX_TOKENS=4096
